<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Card Recharge History Search -->
        <record model="ir.ui.view" id="isy_card_recharge_history_search">
            <field name="name">ISY Card Recharge History Search</field>
            <field name="model">isy.card.recharge.history</field>
            <field name="arch" type="xml">
                <search>
                    <field name="partner_id"/>
                    <field name="student_number"/>
                    <field name="barcode"/>
                    <field name="ptype"/>
                    <filter string="Created Date" name="group_created_date" context="{'group_by': 'create_date:day'}"/>
                    <filter string="Payment Type" name="group_payment_type" context="{'group_by': 'ptype'}"/>
                </search>
            </field>
        </record>

        <!-- Card Recharge History Tree -->
        <record model="ir.ui.view" id="isy_clinic_request_calendar">
            <field name="name">ISY Card Recharge History Tree</field>
            <field name="model">isy.card.recharge.history</field>
            <field name="arch" type="xml">
                <tree default_order='create_date desc'>
                    <field name="partner_id"/>
                    <field name="student_number"/>
                    <field name="ptype"/>
                    <field name="barcode"/>
                    <field name="amount"/>
                    <field name="create_date"/>
                    <field name="date"/>
                </tree>
            </field>
        </record>


        <!-- Card Recharge History Action -->
        <record model="ir.actions.act_window" id="menu_isy_card_recharge_history_action">
            <field name="name">Card Recharge History</field>
            <field name="res_model">isy.card.recharge.history</field>
            <field name="view_mode">tree</field>
            <field name="context">{'group_by': 'create_date:day'}</field>
            <field name="domain">[]</field>
        </record>

        <!-- Card Recharge History Menu --> 
        <menuitem
            name="Card Recharge History"
            id="menu_isy_card_recharge_history"
            parent="isy_pos_addon.menu_isy_card_history_root"
            action="menu_isy_card_recharge_history_action"
            sequence="10"/>
    </data>
</odoo>
