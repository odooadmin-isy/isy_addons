<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- pos.config view -->
    <record id="pos_config_view_form_inherit_isy_card" model="ir.ui.view">
        <field name="name">pos.config.form.inherit.isy_card</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/sheet/div" position="after">
                <setting string="Vendor Payment" help="Enable vendor payment">
                    <field name="is_vendor_payment" />
                    <div class="row mt16 o_settings_container" invisible="not is_vendor_payment">
                        <div class="row">
                            <label string="Vendor" for="vendor_id" class="col-lg-4 o_light_label"/>
                            <field name="vendor_id" />
                        </div>
                        <div class="row">
                            <label string="Commission Journal" for="commission_journal_id" class="col-lg-4 o_light_label"/>
                            <field name="commission_journal_id" />
                        </div>
                        <div class="row">
                            <label string="Commission Percentage" for="commission_percentage" class="col-lg-4 o_light_label"/>
                            <field name="commission_percentage" />
                        </div>
                        <div class="row">
                            <label string="Vendor Control Account" for="vendor_control_account_id" class="col-lg-4 o_light_label"/>
                            <field name="vendor_control_account_id" />
                        </div>
                        <div class="row">
                            <label string="POS Payment Account" for="pos_payment_account_id" class="col-lg-4 o_light_label"/>
                            <field name="pos_payment_account_id" />
                        </div>
                        <div class="row">
                            <label string="Adjustment Account" for="adjustment_account_id" class="col-lg-4 o_light_label"/>
                            <field name="adjustment_account_id" />
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>

    <!-- pos.session view -->
    <record id="view_pos_session_form_inherit_commission" model="ir.ui.view">
        <field name="name">pos.session.form.inherit.commission</field>
        <field name="model">pos.session</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_session_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='move_id']" position="after">
                <field name="commission_move_id" readonly="1" groups="account.group_account_readonly"/>
                <field name="card_sale_payment_move_id" readonly="1" groups="account.group_account_readonly"/>
            </xpath>
        </field>
    </record>

    <!-- pos.payment.method view -->
    <record id="pos_payment_method_view_form_inherit_isy_card" model="ir.ui.view">
        <field name="name">pos.payment.method.form.inherit.isy_card</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='split_transactions']" position="before">
                <field name="use_card" />
                <field name="send_email" />
            </xpath>
        </field>
    </record>

    <!-- POS Payment Summary Pivot -->
    <record id="view_pos_payment_pivot" model="ir.ui.view">
        <field name="name">pos.payment.pivot</field>
        <field name="model">pos.payment</field>
        <field name="arch" type="xml">
            <pivot string="POS Payment Summary">
                <field name="payment_date" type="row" interval="day"/>
                <field name="payment_method_id" type="col"/>
                <field name="amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_pos_payment_summary_pivot" model="ir.actions.act_window">
        <field name="name">POS Payment Summary</field>
        <field name="res_model">pos.payment</field>
        <field name="view_mode">pivot,tree</field>
        <field name="view_id" ref="view_pos_payment_pivot"/>
        <field name="domain">[('pos_order_id.state', 'in', ['paid', 'done', 'invoiced'])]</field>
    </record>

    <!-- pos.order.line action -->
    <record id="action_pos_order_line_custom" model="ir.actions.server">
        <field name="name">Order lines</field>
        <field name="model_id" ref="point_of_sale.model_pos_order_line"/>
        <field name="state">code</field>
        <field name="code">
            action = env['pos.order.line.action.helper'].get_my_pos_order_lines()
        </field>
    </record>

    <menuitem id="menu_pos_order_line_day"
        name="Order Lines Daily"
        parent="point_of_sale.menu_point_of_sale"
        action="isy_pos_addon.action_pos_order_line_custom"
        groups="point_of_sale.group_pos_user"/>

</odoo>
