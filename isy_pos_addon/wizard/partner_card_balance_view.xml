<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_card_balance_wizard" model="ir.ui.view">
        <field name="name">partner.card.balance.wizard.form</field>
        <field name="model">partner.card.balance.wizard</field>
        <field name="arch" type="xml">
            <form string="Partner Card Balance">
                <group>
                    <field name="barcode" string="Barcode"/>
                </group>
                <footer>
                    <button name="action_search" string="Search" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_partner_card_balance_wizard" model="ir.actions.act_window">
        <field name="name">Partner Card Balance</field>
        <field name="res_model">partner.card.balance.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_partner_card_balance_wizard"/>
        <field name="target">new</field>
    </record>

    <record id="view_partner_card_balance_tree" model="ir.ui.view">
        <field name="name">partner.card.balance.tree</field>
        <field name="model">partner.card.balance</field>
        <field name="arch" type="xml">
            <tree string="Partner Card Balance" create="false" edit="false">
                <field name="name"/>
                <field name="barcode"/>
                <field name="student_number"/>
                <field name="balance"/>
            </tree>
        </field>
    </record>

    <menuitem id="menu_partner_card_balance"
              name="Partner Card Balance"
              parent="isy_pos_addon.menu_partner_card_balance_root"
              action="action_partner_card_balance_wizard"
              sequence="10"/>
</odoo>
